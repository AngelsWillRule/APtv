{
    "name": "angelswillrule/openap",
    "description": "Web-managed Wi-Fi access point and repeater for supported Debian-based systems",
    "license": "GPL-3.0",
    "homepage": "https://github.com/AngelsWillRule/OpenAP",
    "keywords": ["raspberry-pi", "debian", "ubuntu", "wifi", "access-point", "repeater"],
    "type": "project",
    "authors": [
        {
          "name": "OpenAP contributors",
          "homepage": "https://github.com/AngelsWillRule/OpenAP",
          "role": "Maintainers"
        },
        {
          "name": "RaspAP contributors",
          "homepage": "https://github.com/RaspAP/raspap-webgui",
          "role": "Upstream authors"
        }
    ],
    "require": {
        "php": "^8.2",
        "phpoption/phpoption": "^1.9",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.2.0",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "squizlabs/php_codesniffer": "^3.9.0",
        "ext-simplexml": "*"
    },
    "scripts": {
        "lint": "parallel-lint . --exclude vendor",
        "phpcs": "phpcs -p -s --config-set installed_paths vendor/phpcompatibility/php-compatibility .",
        "test": [
            "composer lint",
            "composer phpcs"
        ]
    }
}
