set_and_verify_txpower() {
  iface="$1" requested="$2" attempts=6
  while [ "$attempts" -gt 0 ]; do
    if iw dev "$iface" set txpower fixed "$((requested * 100))" 2>/dev/null; then
      actual="$(iw dev "$iface" info 2>/dev/null | awk '$1 == "txpower" {printf "%.0f", $2; exit}')"
      case "$actual" in
        ''|*[!0-9]*) ;;
        *)
          if [ "$actual" -ge 1 ] && [ "$actual" -le "$requested" ]; then
            if [ "$actual" -lt "$requested" ]; then
              echo "$iface TX power clamped by driver from $requested to $actual dBm" >&2
            fi
            return 0
          fi
          ;;
      esac
    fi
    attempts=$((attempts - 1))
    [ "$attempts" -eq 0 ] || sleep 1
  done
  return 1
}

[ -z "$ap24" ] || set_and_verify_txpower "$ap24" "$tx24" || rollback "Unable to set $ap24 TX power to $tx24 dBm"
