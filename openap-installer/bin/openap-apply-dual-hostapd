rollback() {
  reason="${1:-Final hotspot verification failed}"
  trap - EXIT HUP INT TERM
  systemctl stop hostapd.service dnsmasq.service >/dev/null 2>&1 || true
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    rm -f -- "$path"
  done < "$backup_dir/absent-paths"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    [ -e "$backup_dir$path" ] && cp -a "$backup_dir$path" "$path"
  done < "$backup_dir/existing-paths"
  cold_restore_files
  if [ -d "/sys/class/net/$bridge/bridge" ]; then
    ip link set dev "$bridge" down >/dev/null 2>&1 || true
    ip link delete dev "$bridge" type bridge >/dev/null 2>&1 || true
  fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl restart systemd-networkd.service >/dev/null 2>&1 || true
  if [ "$cold_swap_active" -eq 1 ]; then
    systemctl enable --now openap-uplink.service >/dev/null 2>&1 || true
  fi
  [ "$current_mode" != repeater_wifi ] \
    || ip -4 route del default dev "$ethernet" >/dev/null 2>&1 || true
  systemctl reset-failed hostapd.service dnsmasq.service >/dev/null 2>&1 || true
  systemctl restart hostapd.service dnsmasq.service openap-firewall.service >/dev/null 2>&1 || true
  systemctl start openap-uplink-watchdog.timer >/dev/null 2>&1 || true
  if [ -f "$backup_dir/txpower-before" ]; then
    while read -r iface mbm; do
      case "$iface:$mbm" in *[!A-Za-z0-9_.:-]*) continue ;; esac
      iw dev "$iface" set txpower fixed "$mbm" >/dev/null 2>&1 || true
    done < "$backup_dir/txpower-before"
  fi
  record_rollback_result "$reason" "$backup_dir"
  rm -rf -- "$work_dir"
  exit 1
}
