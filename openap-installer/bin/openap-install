ethernet_addr_cidr=""
ethernet_gateway=""
ethernet_dns=""
ethernet_dns_lines=""
if [ "$apply" -eq 1 ]; then
  ap_iface="$(json_value proposed_roles.ap)"
  uplink_iface="$(json_value proposed_roles.uplink)"
  ethernet_iface="$(json_value proposed_roles.ethernet)"
  ethernet_physical_iface="$(json_value proposed_roles.ethernet_physical)"
  # Preserve an already configured Ethernet management address.  Replacing a
  # static uplink with DHCP during AP activation changes the host address and
  # can make the installer session and SSH management path disappear.
  if [ -n "$ethernet_iface" ]; then
    ethernet_addr_cidr="$(ip -4 -o addr show dev "$ethernet_iface" scope global | awk 'NR == 1 {print $4}')"
    ethernet_gateway="$(ip -4 route show default dev "$ethernet_iface" | awk '$1 == "default" {for (i = 1; i <= NF; i++) if ($i == "via") {print $(i + 1); exit}}')"
    ethernet_dns="$(nmcli -g IP4.DNS device show "$ethernet_iface" 2>/dev/null | sed '/^[[:space:]]*$/d' | paste -sd, - || true)"
    if [ -z "$ethernet_dns" ] && [ -r /etc/resolv.conf ]; then
      ethernet_dns="$(awk '$1 == "nameserver" {print $2}' /etc/resolv.conf | paste -sd, -)"
    fi
    ethernet_dns="$(printf '%s\n' "$ethernet_dns" | tr ', ' '\n' | awk -v excluded="$ethernet_gateway" '
      $0 ~ /^[0-9]+(\.[0-9]+){3}$/ && $0 != excluded && $0 !~ /^127\./ && !seen[$0]++ {
        printf "%s%s", sep, $0
        sep = ","
      }
    ')"
    [ -n "$ethernet_dns" ] || ethernet_dns='1.1.1.1,1.0.0.1'
    ethernet_dns_lines="$(printf '%s\n' "$ethernet_dns" | tr ',' '\n' | sed '/^[[:space:]]*$/d; s/^/DNS=/')"
  fi
else
  ap_iface="<detected-ap>"
  uplink_iface="<detected-uplink>"
  ethernet_iface="<detected-ethernet>"
  ethernet_physical_iface="<detected-physical-ethernet>"
fi

