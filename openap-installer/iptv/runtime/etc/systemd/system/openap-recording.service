[Unit]
Description=APtv recording scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
UMask=0007
StateDirectory=openap-recording-state openap-recordings
StateDirectoryMode=0770
ExecStart=/usr/bin/php /usr/local/lib/openap-recording/iptv_recording_worker.php
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt /media /var/lib/openap-recording-state /var/lib/openap-recordings
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
