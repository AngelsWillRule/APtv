#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo 'ERROR: component operations must run as root.' >&2
  exit 1
fi

[ "$#" -eq 5 ] || { echo 'ERROR: invalid component operation.' >&2; exit 2; }
operation="$1"
component="$2"
confirmation="$3"
mode="$4"
job_id="$5"

case "$operation:$component:$confirmation" in
  add:ap:--yes|add:iptv:--yes|remove:ap:--yes|remove:iptv:--yes) ;;
  *) echo 'ERROR: invalid component operation.' >&2; exit 2 ;;
esac
case "$mode" in background|worker) ;; *) echo 'ERROR: invalid component operation.' >&2; exit 2 ;; esac
case "$job_id" in
  ''|*[!a-f0-9]*) echo 'ERROR: invalid component job id.' >&2; exit 2 ;;
esac

manager_root=/usr/local/lib/openap-installer/source
manager="$manager_root/openap-installer/bin/openap-manager"
[ -x "$manager" ] || { echo 'ERROR: installed component manager source is missing.' >&2; exit 3; }

status_dir=/run/openap-component-manager
status_file="$status_dir/status.json"
job_log_dir="$status_dir/jobs"
job_log_file="$job_log_dir/$job_id.log"
log_file=/var/log/openap-component-manager.log
request_dir=/var/lib/openap-component-manager/requests
request_file="$request_dir/$job_id.json"

prepare_job_log() {
  install -d -o root -g www-data -m 0750 "$job_log_dir"
  install -o root -g www-data -m 0640 /dev/null "$job_log_file"
  printf '[component-manager] %s %s --yes\n' "$operation" "$component" >> "$job_log_file"
}

write_status() {
  local state="$1" exit_code="$2" message="$3" now tmp
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  install -d -o root -g www-data -m 0750 "$status_dir"
  tmp="$status_dir/status.json.$$"
  printf '{"job_id":"%s","component":"%s","operation":"%s","state":"%s","exit_code":%s,"message":"%s","updated_at":"%s"}\n' \
    "$job_id" "$component" "$operation" "$state" "$exit_code" "$message" "$now" > "$tmp"
  chown root:www-data "$tmp"
  chmod 0640 "$tmp"
  mv -f "$tmp" "$status_file"
}

if [ "$mode" = background ]; then
  unit=openap-component-manager-operation.service
  if systemctl is-active --quiet "$unit"; then
    write_status failed 4 'Another component operation is already running.'
    exit 4
  fi
  write_status queued 0 'Component operation queued.'
  if ! systemd-run --quiet --unit="$unit" --collect -- \
      /usr/local/sbin/openap-component-manager "$operation" "$component" --yes worker "$job_id"; then
    write_status failed 5 'Unable to start the component operation.'
    exit 5
  fi
  printf '%s\n' "$job_id"
  exit 0
fi

exec 9>/run/lock/openap-component-manager.lock
flock -n 9 || { write_status failed 4 'Another component operation is already running.'; exit 4; }

if [ "$operation:$component" = add:ap ] && [ -f "$request_file" ]; then
  request_owner="$(stat -c '%U' "$request_file" 2>/dev/null || true)"
  [ "$request_owner" = www-data ] || { write_status failed 6 'Invalid AP wizard request owner.'; exit 6; }
  request_json="$(jq -c 'select(type == "object")' "$request_file" 2>/dev/null || true)"
  [ -n "$request_json" ] || { rm -f "$request_file"; write_status failed 6 'Invalid AP wizard request.'; exit 6; }
  ap_iface="$(jq -r '.ap_iface // empty' <<<"$request_json")"
  country="$(jq -r '.country // empty' <<<"$request_json")"
  hotspot_ssid="$(jq -r '.ssid // empty' <<<"$request_json")"
  hotspot_password="$(jq -r '.hotspot_password // empty' <<<"$request_json")"
  admin_user="$(jq -r '.admin_user // empty' <<<"$request_json")"
  admin_password="$(jq -r '.admin_password // empty' <<<"$request_json")"
  case "$ap_iface" in ''|*[!A-Za-z0-9_.-]*) rm -f "$request_file"; write_status failed 6 'Invalid AP interface.'; exit 6 ;; esac
  case "$country" in [A-Z][A-Z]) ;; *) rm -f "$request_file"; write_status failed 6 'Invalid wireless country.'; exit 6 ;; esac
  [ "${#hotspot_ssid}" -ge 1 ] && [ "${#hotspot_ssid}" -le 32 ] || { rm -f "$request_file"; write_status failed 6 'Invalid hotspot SSID.'; exit 6; }
  [ "${#hotspot_password}" -ge 8 ] && [ "${#hotspot_password}" -le 63 ] || { rm -f "$request_file"; write_status failed 6 'Invalid hotspot password.'; exit 6; }
  export OPENAP_AP_IFACE="$ap_iface"
  export OPENAP_WIRELESS_COUNTRY="$country"
  export OPENAP_HOTSPOT_SSID="$hotspot_ssid"
  export OPENAP_HOTSPOT_PASSWORD="$hotspot_password"
  if [ -n "$admin_user" ]; then export OPENAP_ADMIN_USERNAME="$admin_user"; fi
  if [ -n "$admin_password" ]; then export OPENAP_ADMIN_PASSWORD="$admin_password"; fi
  rm -f "$request_file"
fi

write_status running 0 'Component operation in progress.'
prepare_job_log
if [ ! -e "$log_file" ]; then
  install -o root -g root -m 0600 /dev/null "$log_file"
fi
set +e
"$manager" "$operation" "$component" --yes >> "$job_log_file" 2>&1
exit_code=$?
set -e
printf '[component-manager] exit code: %s\n' "$exit_code" >> "$job_log_file"
cat "$job_log_file" >> "$log_file"
if [ "$exit_code" -eq 0 ]; then
  write_status success 0 'Component operation completed.'
else
  write_status failed "$exit_code" 'Component operation failed.'
fi
exit "$exit_code"

exec "$manager" "$operation" "$component" --yes
